@page
@model NCMS.IoT.Host.Pages.AppPackages.Packages.IndexModel
@{
    ViewData["Title"] = "Application Packages";
    ViewData["Pretitle"] = "Application deployment";
    ViewData["Purpose"] = "Manage application package versions, compatibility, tags, and deployment metadata.";
    ViewData["HeaderIcon"] = "box";
}

<style>
    .tags-input{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;min-height:2.375rem;padding:.35rem .45rem;
        border:1px solid var(--tblr-border-color,#dadfe5);border-radius:.375rem;background:#fff;}
    .tag-chip{display:inline-flex;align-items:center;gap:.45rem;border:1px solid #5bc7e6;color:#26a9d1;background:#fff;
        border-radius:999px;padding:.22rem .3rem .22rem .75rem;font-size:.8125rem;line-height:1;}
    .tag-chip-x{display:inline-flex;align-items:center;justify-content:center;width:1.15rem;height:1.15rem;border:0;
        border-radius:50%;background:#29abd6;color:#fff;cursor:pointer;padding:0;}
    .tag-chip-x:hover{background:#1f93ba;}
    .tag-add-btn{border:1px solid #ced4da;color:#6c757d;background:#fff;border-radius:999px;padding:.22rem .95rem;
        font-size:.8125rem;line-height:1.45;cursor:pointer;}
    .tag-add-btn:hover{background:#f6f8fa;}
    .tag-input-field{border:0;outline:0;min-width:6rem;flex:1;font-size:.8125rem;padding:.2rem .25rem;background:transparent;}
</style>

<div x-data="tableController" data-table-controller>
<!-- ── Filter bar (server-side GET; intercepted for partial updates) ──────── -->
<form method="get" @@submit.prevent="onSubmit($event)">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="card card-sm mb-3">
        <div class="card-body">
           <div class="d-grid"
     style="grid-template-columns:minmax(0,1fr) auto;column-gap:1rem;align-items:end;">

    <!-- Filters -->
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Package Name -->
        <div style="min-width:260px;flex:0 1 260px;">
            <label class="form-label small text-secondary mb-1">
                Package Name
            </label>

            <input type="text"
                   name="name"
                   value="@Model.Name"
                   class="form-control form-control-sm"
                   placeholder="Package name" />
        </div>

        <!-- Version -->
        <div style="min-width:140px;flex:0 1 140px;">
            <label class="form-label small text-secondary mb-1">
                Version
            </label>

            <input type="text"
                   name="version"
                   value="@Model.Version"
                   class="form-control form-control-sm"
                   placeholder="e.g. 1.2" />
        </div>

        <!-- Product -->
        <div style="min-width:220px;flex:0 1 220px;">
            <label class="form-label small text-secondary mb-1">
                Product Model
            </label>

            <select name="productId"
                    class="form-select form-select-sm">
                <option value="">All Models</option>

                @foreach (var p in Model.ProductOptions)
                {
                    <option value="@p.Value"
                            selected="@(Model.ProductId?.ToString() == p.Value)">
                        @p.Text
                    </option>
                }
            </select>
        </div>

        <!-- Tags -->
        <div style="min-width:180px;flex:0 1 180px;">
            <label class="form-label small text-secondary mb-1">
                Tags
            </label>

            <input type="text"
                   name="tag"
                   value="@Model.Tag"
                   class="form-control form-control-sm"
                   placeholder="e.g. network" />
        </div>

        <!-- Status -->
        <div style="min-width:140px;flex:0 1 140px;">
            <label class="form-label small text-secondary mb-1">
                Status
            </label>

            <select name="enabled"
                    class="form-select form-select-sm">
                <option value="">All</option>
                <option value="true"
                        selected="@(Model.Enabled == true)">
                    Enabled
                </option>
                <option value="false"
                        selected="@(Model.Enabled == false)">
                    Disabled
                </option>
            </select>
        </div>

    </div>

    <!-- Search / Reset -->
    <div class="align-self-start">
        <!-- Invisible label keeps the buttons aligned with the first-row inputs (not the labels). -->
        <label class="form-label small text-secondary mb-1" aria-hidden="true" style="visibility:hidden;">&nbsp;</label>
        <div class="d-flex gap-2 flex-nowrap">
            <button type="submit"
                    class="btn btn-sm btn-primary text-nowrap">
                Search
            </button>

            <a asp-page="/AppPackages/Packages/Index"
               class="btn btn-sm btn-outline-secondary text-nowrap">
                Reset
            </a>
        </div>
    </div>

</div>
        </div>
    </div>
</form>

<div x-data="pkgIndex()" x-init="init()">

    <!-- ── Results (swapped in place by tableController) ────────────────────── -->
    <div id="results" @@click="onClick($event)" @@change="onChange($event)"
         :class="{ 'opacity-50 pe-none': tableLoading }" style="transition:opacity .15s">
        <partial name="_Results" model="Model" />
    </div>

    @* ── Unified Create / Edit modal (single Save) ─────────────────────────── *@
    <template x-if="form.show">
        <div>
            <div class="modal modal-blur fade show d-block" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <form class="modal-content" method="post" enctype="multipart/form-data"
                          x-bind:action="window.location.pathname + '?handler=' + (form.mode === 'edit' ? 'SaveVersion' : 'CreatePackage')">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" x-show="form.mode === 'create'">Add Application Package</h5>
                            <h5 class="modal-title" x-show="form.mode === 'edit'">
                                Edit — <span x-text="form.name"></span> <span class="text-secondary">v</span><span x-text="form.version"></span>
                            </h5>
                            <button type="button" class="btn-close" @@click="form.show = false"></button>
                        </div>
                        <div class="modal-body loading-region" :class="{ 'is-loading': form.loading }">
                            <div>
                                <template x-if="form.mode === 'edit'"><input type="hidden" name="packageId" :value="form.packageId" /></template>
                                <template x-if="form.mode === 'edit'"><input type="hidden" name="id" :value="form.id" /></template>

                                @* ── Name ── *@
                                <div class="mb-3">
                                    <label class="form-label required">Application Name</label>
                                    <input name="name" class="form-control" maxlength="200" required autocomplete="off" x-model="form.name"
                                           placeholder="Existing name adds a new version to that package" />
                                    <div class="form-hint" x-show="form.mode === 'edit'">Renaming affects every version of this package.</div>
                                </div>                             
                                @* ── Version (immutable on edit) ── *@
                                <div class="mb-3">
                                    <label class="form-label" :class="form.mode === 'create' && 'required'">Application Version</label>
                                    <input name="version" class="form-control" maxlength="50" autocomplete="off" x-model="form.version"
                                           :required="form.mode === 'create'" :disabled="form.mode === 'edit'" placeholder="e.g. 1.2.0" />
                                    <div class="form-hint" x-show="form.mode === 'edit'">Immutable after creation.</div>
                                </div>

                                @* ── Package Format (immutable on edit) ── *@
                                <div class="mb-3">
                                    <label class="form-label" :class="form.mode === 'create' && 'required'">Application Format</label>
                                    <input name="packageFormat" class="form-control" maxlength="50" autocomplete="off" x-model="form.packageFormat"
                                           :required="form.mode === 'create'" :disabled="form.mode === 'edit'"
                                           placeholder="e.g. ipk, deb, zip — interpreted by the device agent" />
                                    <div class="form-hint" x-show="form.mode === 'edit'">Immutable after creation.</div>
                                </div>

                                @* ── Package File (required on create, optional replace on edit) ── *@
                                <div class="mb-3">
                                    <label class="form-label" :class="form.mode === 'create' && 'required'">Application File</label>
                                    <div class="mb-2" x-show="form.fileName && !form.newFileName">
                                        <span class="text-primary fw-medium" x-text="form.fileName"></span>
                                        <span class="text-secondary small ms-1">(current — upload a new file to replace)</span>
                                    </div>
                                    <label class="upload-dropzone">
                                        <icon name="cloud-upload" size="40" class="text-secondary mb-2" />
                                        <div x-text="form.mode === 'edit' ? 'Click or drag a new file to replace' : 'Click or drag the package file here to upload'"></div>
                                        <span class="fw-medium text-primary mt-2" x-show="form.newFileName" x-text="form.newFileName"></span>
                                        <input type="file" name="file" :required="form.mode === 'create'"
                                               @@change="form.newFileName = $event.target.files[0]?.name || ''" />
                                    </label>
                                </div>

                                @* ── Tags ── *@
                                <div class="mb-3">
                                    <label class="form-label">Tags</label>
                                    <div class="tags-input">
                                        <template x-for="(t, i) in form.tags" :key="i">
                                            <span class="tag-chip">
                                                <span x-text="t"></span>
                                                <button type="button" class="tag-chip-x" @@click="form.tags.splice(i, 1)" aria-label="Remove tag">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                                </button>
                                            </span>
                                        </template>
                                        <template x-if="form.adding">
                                            <input type="text" class="tag-input-field" x-model="form.draft"
                                                   x-init="$nextTick(() => $el.focus())"
                                                   @@keydown.enter.prevent="addTag(form)"
                                                   @@keydown.backspace="!form.draft && form.tags.pop()"
                                                   @@blur="addTag(form); form.adding = false" placeholder="Type & Enter" />
                                        </template>
                                        <button type="button" class="tag-add-btn" x-show="!form.adding" @@click="form.adding = true">+Tags</button>
                                    </div>
                                    <template x-for="t in form.tags" :key="'h-' + t"><input type="hidden" name="tags" :value="t" /></template>
                                    <div class="form-hint">Optional labels for grouping/searching. Ignored when the package already exists.</div>
                                </div>
                                 @* ── Product Model (locked while enabled) — populated the same way as the
                                      New Firmware Package dialog: server-rendered from Model.ProductOptions. ── *@
                                <div class="mb-3">
                                    <label class="form-label required">Product Model</label>
                                    <select class="form-select" required :disabled="form.mode === 'edit' && form.isEnabled" x-model="form.productId">
                                        <option value="">Select a product model…</option>
                                        @foreach (var p in Model.ProductOptions)
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    </select>
                                    <template x-if="form.productId"><input type="hidden" name="productIds" :value="form.productId" /></template>
                                    @if (Model.ProductOptions.Count == 0)
                                    {
                                        <div class="form-hint text-danger">No products support application packages yet.</div>
                                    }
                                    <div class="text-secondary small mt-1" x-show="form.mode === 'edit' && form.isEnabled">
                                        This version is Enabled — disable it to change its compatible product.
                                    </div>
                                </div>

                                @* ── Release Notes ── *@
                                <div class="mb-3">
                                    <label class="form-label">Remark</label>
                                    <textarea name="releaseNotes" class="form-control" rows="3" x-model="form.releaseNotes"></textarea>
                                </div>

                                @* ── Dependencies (edit only) ── *@
                                <template x-if="form.mode === 'edit'">
                                    <div>
                                        <input type="hidden" name="dependenciesJson" :value="JSON.stringify(form.dependencies)" />
                                        <label class="form-label">Dependencies <small class="text-secondary">(informational only)</small></label>
                                        <table class="table table-sm mb-2">
                                            <thead><tr><th>Depends On</th><th>Version Constraint</th><th class="w-1"></th></tr></thead>
                                            <tbody>
                                                <template x-for="(d, i) in form.dependencies" :key="i">
                                                    <tr>
                                                        <td>
                                                            <select class="form-select form-select-sm" x-model="d.dependsOnApplicationPackageId">
                                                                <option value="">Select…</option>
                                                                <template x-for="op in otherPackages" :key="op.id">
                                                                    <option :value="op.id" x-text="op.name"></option>
                                                                </template>
                                                            </select>
                                                        </td>
                                                        <td><input type="text" class="form-control form-control-sm" x-model="d.versionConstraint" placeholder="e.g. >= 2.0" /></td>
                                                        <td><button type="button" class="btn btn-link text-red p-0" @@click="form.dependencies.splice(i, 1)">✕</button></td>
                                                    </tr>
                                                </template>
                                            </tbody>
                                        </table>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @@click="form.dependencies.push({ dependsOnApplicationPackageId: '', versionConstraint: '' })">
                                            + Add Dependency
                                        </button>
                                    </div>
                                </template>

                                <div class="form-hint mt-3" x-show="form.mode === 'create'">The version is created Disabled — enable it from the list once you've reviewed it.</div>
                            </div>
                        </div>
                        <div class="modal-footer justify-content-center">
                            <button type="button" class="btn" @@click="form.show = false">Close</button>
                            <button type="submit" class="btn btn-primary" :disabled="form.loading">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        </div>
    </template>
</div>
</div>

@section Scripts {
    <script>
        function pkgIndex() {
            const blankForm = () => ({
                show: false, mode: 'create', loading: false,
                packageId: '', id: '', name: '', tags: [], adding: false, draft: '',
                version: '', packageFormat: '', fileName: '', newFileName: '',
                releaseNotes: '', productId: '', isEnabled: false, dependencies: []
            });

            return {
                otherPackages: [],
                form: blankForm(),

                // Product Model options come from Model.ProductOptions (server-rendered <option>s
                // in the select itself) — the same population approach as the New Firmware Package
                // dialog — so there's no client-side products fetch here.
                async init() {
                    const res = await fetch(window.location.pathname + '?handler=OtherPackages', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    this.otherPackages = res.ok ? await res.json() : [];
                },

                // Commit the draft tag: trim, de-dupe (case-insensitive), keep order.
                addTag(state) {
                    const v = (state.draft || '').trim();
                    if (v && !state.tags.some(t => t.toLowerCase() === v.toLowerCase())) state.tags.push(v);
                    state.draft = '';
                },

                openCreate() {
                    this.form = { ...blankForm(), show: true, mode: 'create' };
                },

                async openEdit(id) {
                    this.form = { ...blankForm(), show: true, mode: 'edit', loading: true, id };
                    try {
                        const res = await fetch(window.location.pathname + '?handler=Detail&id=' + encodeURIComponent(id),
                            { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' });
                        const d = await res.json();
                        this.form.packageId = d.applicationPackageId;
                        this.form.name = d.packageName || '';
                        this.form.tags = d.tags || [];
                        this.form.version = d.version;
                        this.form.packageFormat = d.packageFormat;
                        this.form.isEnabled = d.isEnabled;
                        this.form.fileName = d.fileName || '';
                        this.form.releaseNotes = d.releaseNotes || '';
                        // Compatibility is a single Product Model — take the first stored one.
                        this.form.productId = (d.compatibleProductIds || [])[0] || '';
                        this.form.dependencies = (d.dependencies || []).map(x => ({
                            dependsOnApplicationPackageId: x.dependsOnApplicationPackageId, versionConstraint: x.versionConstraint || ''
                        }));
                    } finally { this.form.loading = false; }
                }
            };
        }
    </script>
}
