@model NCMS.IoT.Host.Pages.Firmware.UpgradeTasks.IndexModel
@using NCMS.IoT.DeviceManagement.Contracts.Permissions
@*
    Results region for Firmware Tasks — swapped in by tableController. Row "View" buttons
    (@click) bind to the page's `upgradeTasks` component; Alpine re-initialises after each swap.
*@
@{
    SortHeaderVm Sortable(string key, string label) => new()
    {
        Key = key,
        Label = label,
        CurrentSort = Model.Sort,
        PageName = "/Firmware/UpgradeTasks/Index",
        RouteValues = Model.FilterRouteValues()
    };
}
<div class="card">
    <div class="card-body">
        <div class="btn-list">
            <button type="button" class="btn btn-primary" asp-permission="@DeviceManagementPermissions.UpgradeTasks.Add" @@click="openCreate()">
                <i class="ti ti-plus me-1"></i>New Firmware Task
            </button>
        </div>
    </div>
    <div id="advanced-table">
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th class="w-1">#</th>
                        <th><partial name="_SortHeader" model='Sortable("name", "Firmware Task Name")' /></th>
                        <th>Target Version</th>
                        <th>Upgrade Progress</th>
                        <th><partial name="_SortHeader" model='Sortable("status", "Status")' /></th>
                        <th><partial name="_SortHeader" model='Sortable("created", "Start Time")' /></th>
                        <th><partial name="_SortHeader" model='Sortable("completed", "End Time")' /></th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="table-tbody">
                    @{ var idx = (Model.Result.PageNumber - 1) * Model.Result.PageSize; }
                    @foreach (var t in Model.Result.Items)
                    {
                        idx++;
                        <tr>
                            <td class="text-secondary">@idx</td>
                            <td class="text-truncate" style="max-width: 22rem;">@t.TaskName</td>
                            <td><span class="font-monospace">@t.UpgradedVersion</span></td>
                            <td><span class="text-blue fw-bold">@t.SucceededDevices/@t.TotalDevices</span></td>
                            <td><span class="badge @Ui.Badge(t.TaskStatus)">@t.TaskStatus</span></td>
                            <td class="text-nowrap">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="text-nowrap">@(t.EndTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                            <td class="text-center text-nowrap">
                                <button type="button" class="btn btn-link btn-sm p-1 text-primary"
                                        asp-permission="@DeviceManagementPermissions.UpgradeTasks.View"
                                        @@click="openDetail('@t.Id')">View</button>
                            </td>
                        </tr>
                    }
                    @if (Model.Result.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-4">
                                No firmware tasks match the current filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>
