@using NCMS.IoT.Identity.Contracts.Services
@inject NCMS.IoT.Host.Application.Abstractions.INavigationMenuProvider MenuProvider
@inject ICurrentUser CurrentUser
@{
    var currentPage = (ViewContext.RouteData.Values["page"]?.ToString() ?? "/").ToLowerInvariant();

    bool IsVisible(NCMS.IoT.Host.Application.Abstractions.NavigationMenuItem item) =>
        item.RequiredPermission is null || CurrentUser.HasPermission(item.RequiredPermission);

    // Leaf items are filtered by their own permission; a group is a group by construction
    // (its Children list is never null, even once emptied), so it's kept for the next step
    // rather than mistaken for a permission-less leaf.
    var items = MenuProvider.GetItems()
        .Where(item => item.Children is not null || IsVisible(item))
        .Select(item => item.Children is not null
            ? item with { Children = item.Children.Where(IsVisible).ToList() }
            : item)
        .Where(item => item.Children is null || item.Children.Count > 0)
        .ToList();

    bool IsActiveItem(NCMS.IoT.Host.Application.Abstractions.NavigationMenuItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ActivePrefix))
            return currentPage.StartsWith(item.ActivePrefix.ToLowerInvariant());
        return currentPage == item.Page.ToLowerInvariant();
    }
}

<aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand pe-0 pe-md-3" asp-page="/Index">
            <img src="@NCMS.IoT.Host.Models.Settings.Logo"
                 alt="@NCMS.IoT.Host.Models.Settings.App"
                 class="navbar-brand-image" style="height:3rem;width:auto" />
        </a>

        <div class="collapse navbar-collapse" id="sidebar-menu">
            <!-- BEGIN NAVBAR MENU -->
            <ul class="navbar-nav pt-lg-3">
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    if (!item.HasChildren)
                    {
                        <li class="nav-item @(IsActiveItem(item) ? "active" : "")">
                            <a class="nav-link" asp-page="@item.Page">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><icon name="@item.Icon" /></span>
                                <span class="nav-link-title">@item.Title</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        var open = item.Children!.Any(IsActiveItem);
                        var menuId = $"navbar-menu-{i}";
                        <li class="nav-item dropdown @(open ? "active" : "")">
                            <a class="nav-link dropdown-toggle" href="#@menuId" data-bs-toggle="dropdown"
                               data-bs-auto-close="false" role="button" aria-expanded="@(open ? "true" : "false")">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><icon name="@item.Icon" /></span>
                                <span class="nav-link-title">@item.Title</span>
                            </a>
                            <div class="dropdown-menu @(open ? "show" : "")">
                                @foreach (var child in item.Children!)
                                {
                                    <a class="dropdown-item @(IsActiveItem(child) ? "active" : "")" asp-page="@child.Page">
                                        @child.Title
                                    </a>
                                }
                            </div>
                        </li>
                    }
                }
            </ul>
            <!-- END NAVBAR MENU -->
        </div>
    </div>
</aside>
