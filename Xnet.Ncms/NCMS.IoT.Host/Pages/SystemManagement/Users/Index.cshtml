@page
@using NCMS.IoT.Identity.Contracts.Permissions
@model NCMS.IoT.Host.Pages.SystemManagement.Users.IndexModel
@{
    ViewData["Title"] = "User Manage";
    ViewData["Pretitle"] = "System Management";
    ViewData["Purpose"] = "Create and manage user accounts, assign roles, and reset passwords.";
    ViewData["HeaderIcon"] = "users";

    var pager = new NCMS.IoT.Host.Models.PagerInfo
    {
        Page = Model.Result.PageNumber,
        PageSize = Model.Result.PageSize,
        Total = (int)Model.Result.TotalCount,
        PageName = "/SystemManagement/Users/Index",
        PageSizeOptions = Model.PageSizeOptions,
        Query = Model.FilterRouteValues()
    };
}

<div x-data="usersPage()">

    <!-- ── Filter bar ───────────────────────────────────────────────────── -->
    <form method="get">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="card card-sm mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-end">
                    <div style="min-width:240px;flex:1 1 260px;">
                        <label class="form-label small text-secondary mb-1">Search</label>
                        <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm"
                               placeholder="User name, email or name" />
                    </div>
                    <div style="min-width:180px;">
                        <label class="form-label small text-secondary mb-1">Role</label>
                        <select name="role" class="form-select form-select-sm">
                            <option value="">All roles</option>
                            @foreach (var r in Model.AllRoles)
                            {
                                <option value="@r.Name" selected="@(Model.Role == r.Name)">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div style="min-width:160px;">
                        <label class="form-label small text-secondary mb-1">Status</label>
                        <select name="isActive" class="form-select form-select-sm">
                            <option value="">All statuses</option>
                            <option value="true" selected="@(Model.IsActive == true)">Active</option>
                            <option value="false" selected="@(Model.IsActive == false)">Disabled</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Search</button>
                        <a asp-page="/SystemManagement/Users/Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card">
        <div class="card-body">
            <div class="btn-list">
                <button type="button" class="btn btn-primary" asp-permission="@IdentityPermissions.Users.Add" data-bs-toggle="modal" data-bs-target="#modal-create">
                    <i class="ti ti-plus me-1"></i>Add User
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th class="text-center col-actions">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Result.Items)
                    {
                        <tr>
                            <td>@u.UserName</td>
                            <td>@u.Email</td>
                            <td>@($"{u.FirstName} {u.LastName}".Trim())</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge bg-blue-lt me-1">@r</span>
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-lt">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">Disabled</span>
                                }
                            </td>
                            <td class="text-center text-nowrap col-actions">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-link btn-sm p-1 text-primary"
                                            asp-permission="@IdentityPermissions.Users.Edit"
                                            data-bs-toggle="modal" data-bs-target="#modal-edit"
                                            data-id="@u.Id" data-first-name="@u.FirstName" data-last-name="@u.LastName"
                                            data-is-active="@u.IsActive.ToString().ToLowerInvariant()"
                                            data-roles="@string.Join(",", u.Roles)"
                                            @@click="openEdit($el)">Edit</button>
                                    <button type="button" class="btn btn-link btn-sm p-1 text-secondary"
                                            asp-permission="@IdentityPermissions.Users.Edit"
                                            data-bs-toggle="modal" data-bs-target="#modal-reset"
                                            data-id="@u.Id" data-name="@u.UserName"
                                            @@click="openReset($el)">Reset Password</button>
                                    <button type="button" class="btn btn-link btn-sm p-1 text-danger"
                                            asp-permission="@IdentityPermissions.Users.Delete"
                                            data-id="@u.Id" data-name="@u.UserName"
                                            @@click="openDelete($el)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Result.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-secondary py-4">No users found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    </div>

    <!-- ── Create modal ─────────────────────────────────────────────────── -->
    <div class="modal modal-blur fade" id="modal-create" tabindex="-1">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <form class="modal-content" method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label required">User Name</label>
                            <input name="UserName" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label required">Email</label>
                            <input name="Email" type="email" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" class="form-control" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" class="form-control" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label required">Password</label>
                            <input name="Password" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Roles</label>
                            <select name="Roles" class="form-select" multiple size="@Math.Max(3, Model.AllRoles.Count)">
                                @foreach (var r in Model.AllRoles)
                                {
                                    <option value="@r.Name">@r.Name</option>
                                }
                            </select>
                            <div class="form-text">Hold Ctrl (Cmd on Mac) to select one or more roles.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Edit modal ───────────────────────────────────────────────────── -->
    <div class="modal modal-blur fade" id="modal-edit" tabindex="-1">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <form class="modal-content" method="post" asp-page-handler="Edit">
                <input type="hidden" name="Id" x-model="edit.id" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" class="form-control" x-model="edit.firstName" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" class="form-control" x-model="edit.lastName" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive"
                                       value="true" x-model="edit.isActive" />
                                <span class="form-check-label">Active</span>
                            </label>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Roles</label>
                            <select name="Roles" class="form-select" multiple size="@Math.Max(3, Model.AllRoles.Count)" x-model="edit.roles">
                                @foreach (var r in Model.AllRoles)
                                {
                                    <option value="@r.Name">@r.Name</option>
                                }
                            </select>
                            <div class="form-text">Hold Ctrl (Cmd on Mac) to select one or more roles.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Reset password modal ─────────────────────────────────────────── -->
    <div class="modal modal-blur fade" id="modal-reset" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <form class="modal-content" method="post" asp-page-handler="ResetPassword">
                <input type="hidden" name="id" x-model="reset.id" />
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary" x-text="'Set a new password for ' + reset.name + '.'"></p>
                    <label class="form-label required">New Password</label>
                    <input name="newPassword" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Delete form (hidden; submitted after confirmAction() approves) ─── -->
    <form method="post" asp-page-handler="Delete" x-ref="deleteForm" class="d-none">
        <input type="hidden" name="id" x-model="del.id" />
    </form>
</div>

@section Scripts {
<script>
    function usersPage() {
        return {
            edit: { id: '', firstName: '', lastName: '', isActive: true, roles: [] },
            reset: { id: '', name: '' },
            del: { id: '', name: '' },
            openEdit(el) {
                const d = el.dataset;
                this.edit = {
                    id: d.id,
                    firstName: d.firstName || '',
                    lastName: d.lastName || '',
                    isActive: d.isActive === 'true',
                    roles: d.roles ? d.roles.split(',').filter(Boolean) : []
                };
            },
            openReset(el) {
                this.reset = { id: el.dataset.id, name: el.dataset.name };
            },
            openDelete(el) {
                const id = el.dataset.id, name = el.dataset.name;
                this.del = { id, name };
                confirmAction('Confirm Delete', 'Do you want to delete this user?',
                    () => this.$nextTick(() => this.$refs.deleteForm.requestSubmit()),
                    { itemName: name });
            }
        };
    }
</script>
}
