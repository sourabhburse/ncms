{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "NCMS.IoT": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IoTDatabase": "Host=localhost;Database=ncms_iot;Username=postgres;Password=12345"
  },
  "Jwt": {
    "Issuer": "NCMS.IoT",
    "Audience": "NCMS.IoT.Clients",
    "SigningKey": "REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS_LONG",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "RootCa": {
    "CertificatePath": "/etc/ncms/pki/ca.crt",
    "PrivateKeyPath": "/etc/ncms/pki/ca.key",
    "IssuerOrganization": "NCMS IoT Platform"
  },
  "Ztp": {
    "CertRenewalUrl": "https://api.ncms.example.com/api/v1/certificates/renew",
    "TelemetryIntervalSeconds": 60,
    "StatusIntervalSeconds": 30,
    "CertRenewalThresholdDays": 90,
    "Broker": {
      "Host": "mqtt.ncms.example.com",
      "Port": 8884,
      "KeepAliveSeconds": 60,
      "SessionExpirySeconds": 300
    }
  },
  "DevicePresence": {
    // The reaper marks a device offline after it misses this many heartbeats
    // (interval = Ztp:StatusIntervalSeconds). Sweep runs every SweepIntervalSeconds.
    "SweepIntervalSeconds": 30,
    "OfflineAfterMissedHeartbeats": 3
  },
  "FileStorage": {
    // Shared with the Host (same server). The DB stores this physical path.
    "StoragePath": "/var/lib/ncms/files",
    // Device download base URL = {PublicBaseUrl}/{segment}/{file} — point at the Host's public address.
    "PublicBaseUrl": "http://82.180.146.203:5081",
    // URL path segments under which files are served to devices (optional; defaults shown).
    "FirmwareUrlSegment": "firmware-files",
    "ConfigUrlSegment": "config-files",
    "ApplicationUrlSegment": "application-files"
  },
  "Mqtt": {
    "BrokerHost": "mqtt.xnet-iot.com",
    "BrokerPort": 8884,
    "ClientId": "ncms-client",
    "Username": "ncms-client",
    "KeepAliveSeconds": 60,
    "ReconnectDelaySeconds": 5,
    "MaxPendingMessages": 1000,
    "Topics": {
      "Telemetry": "d/+/telemetry",
      "Heartbeat": "d/+/heartbeat",
      "Events": "d/+/events",
      "OtaStatus": "d/+/ota/res",
      "AppStatus": "d/+/application/res"
    }
  }
}
